
const taskForm = document.getElementById("taskForm");
const taskInput = document.getElementById("taskInput");
const taskDate = document.getElementById("taskDate");
const taskList = document.getElementById("taskList");
const taskSummary = document.getElementById("taskSummary");
const calendarDays = document.getElementById("calendarDays");
const monthYear = document.getElementById("monthYear");
const selectedDateTasks = document.getElementById("selectedDateTasks");

const today = new Date();
today.setHours(0, 0, 0, 0);

function dateKey(date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

const todayKey = dateKey(today);
taskDate.value = todayKey;

function loadTasks() {
  try {
    const saved = JSON.parse(localStorage.getItem("workhub_tasks") || "[]");
    return Array.isArray(saved) ? saved.filter(task =>
      task &&
      typeof task.id === "string" &&
      typeof task.title === "string" &&
      typeof task.date === "string" &&
      /^\d{4}-\d{2}-\d{2}$/.test(task.date) &&
      typeof task.completed === "boolean"
    ) : [];
  } catch {
    return [];
  }
}

let tasks = loadTasks();
let currentFilter = "all";
let calendarDate = new Date(today.getFullYear(), today.getMonth(), 1);
let selectedDate = todayKey;

function saveTasks() {
  try {
    localStorage.setItem("workhub_tasks", JSON.stringify(tasks));
    return true;
  } catch {
    alert("Could not save tasks. Your browser storage may be full or disabled.");
    return false;
  }
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

function formatDate(dateString) {
  const [year, month, day] = dateString.split("-").map(Number);
  return new Date(year, month - 1, day).toLocaleDateString(
    undefined,
    { month: "short", day: "numeric", year: "numeric" }
  );
}

taskForm.addEventListener("submit", event => {
  event.preventDefault();

  const title = taskInput.value.trim();
  const date = taskDate.value;

  if (!title || !date) return;

  const task = {
    id: crypto.randomUUID
      ? crypto.randomUUID()
      : `${Date.now()}-${Math.random()}`,
    title,
    date,
    completed: false
  };

  tasks.push(task);

  if (!saveTasks()) {
    tasks.pop();
    return;
  }

  selectedDate = date;
  currentFilter = "all";
  document.querySelectorAll(".filter").forEach(button => {
    button.classList.toggle("active", button.dataset.filter === "all");
  });

  calendarDate = new Date(
    Number(date.slice(0, 4)),
    Number(date.slice(5, 7)) - 1,
    1
  );

  taskInput.value = "";
  renderAll();
  taskInput.focus();
});

function getVisibleTasks() {
  const sorted = [...tasks].sort((a, b) =>
    a.date.localeCompare(b.date)
  );

  if (currentFilter === "today") {
    return sorted.filter(task => task.date === todayKey);
  }

  if (currentFilter === "pending") {
    return sorted.filter(task => !task.completed);
  }

  if (currentFilter === "completed") {
    return sorted.filter(task => task.completed);
  }

  return sorted;
}

function renderTasks() {
  const visible = getVisibleTasks();
  const completedCount = tasks.filter(task => task.completed).length;

  taskSummary.textContent =
    `${tasks.length} tasks · ${completedCount} completed · ` +
    `${tasks.length - completedCount} remaining`;

  taskList.replaceChildren();

  if (visible.length === 0) {
    const empty = document.createElement("li");
    empty.className = "muted";
    empty.textContent = "No tasks here. Enjoy the free space! ✨";
    taskList.appendChild(empty);
    return;
  }

  visible.forEach(task => {
    const item = document.createElement("li");
    item.className = "task-item" + (task.completed ? " done" : "");

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.className = "task-check";
    checkbox.checked = task.completed;
    checkbox.setAttribute("aria-label", `Complete ${task.title}`);

    checkbox.addEventListener("change", () => {
      const previous = task.completed;
      task.completed = checkbox.checked;

      if (!saveTasks()) {
        task.completed = previous;
      }

      renderAll();
    });

    const info = document.createElement("div");
    info.className = "task-info";

    const title = document.createElement("div");
    title.className = "task-title";
    title.textContent = task.title;

    const meta = document.createElement("div");
    meta.className = "task-meta";
    meta.textContent =
      (task.date < todayKey && !task.completed ? "Overdue · " : "") +
      formatDate(task.date);

    info.append(title, meta);

    const remove = document.createElement("button");
    remove.className = "delete-btn";
    remove.textContent = "Delete";
    remove.setAttribute("aria-label", `Delete ${task.title}`);

    remove.addEventListener("click", () => {
      if (!confirm("Delete this task?")) return;

      const oldTasks = tasks;
      tasks = tasks.filter(item => item.id !== task.id);

      if (!saveTasks()) {
        tasks = oldTasks;
      }

      renderAll();
    });

    item.append(checkbox, info, remove);
    taskList.appendChild(item);
  });
}

function renderCalendar() {
  calendarDays.replaceChildren();

  monthYear.textContent = calendarDate.toLocaleDateString(
    undefined,
    { month: "long", year: "numeric" }
  );

  const year = calendarDate.getFullYear();
  const month = calendarDate.getMonth();

  const firstDay = new Date(year, month, 1);
  const offset = (firstDay.getDay() + 6) % 7;
  const daysInMonth = new Date(year, month + 1, 0).getDate();

  for (let i = 0; i < offset; i++) {
    const blank = document.createElement("div");
    blank.className = "day empty";
    blank.setAttribute("aria-hidden", "true");
    calendarDays.appendChild(blank);
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const date = new Date(year, month, day);
    const key = dateKey(date);

    const button = document.createElement("button");
    button.className = "day";
    button.textContent = day;

    if (key === todayKey) button.classList.add("today");
    if (key === selectedDate) button.classList.add("selected");

    if (tasks.some(task => task.date === key)) {
      button.classList.add("has-tasks");
    }

    button.setAttribute("aria-label", formatDate(key));

    button.addEventListener("click", () => {
      selectedDate = key;
      renderCalendar();
      renderSelectedDateTasks();
    });

    calendarDays.appendChild(button);
  }

  renderSelectedDateTasks();
}

function renderSelectedDateTasks() {
  selectedDateTasks.replaceChildren();

  const heading = document.createElement("p");
  heading.textContent = `Tasks for ${formatDate(selectedDate)}`;
  heading.style.fontWeight = "bold";
  selectedDateTasks.appendChild(heading);

  const matching = tasks.filter(task => task.date === selectedDate);

  if (matching.length === 0) {
    const empty = document.createElement("p");
    empty.className = "muted";
    empty.textContent = "No tasks scheduled for this date.";
    selectedDateTasks.appendChild(empty);
    return;
  }

  matching.forEach(task => {
    const item = document.createElement("div");
    item.className = "date-task";
    item.textContent =
      `${task.completed ? "✅" : "📝"} ${task.title}`;
    selectedDateTasks.appendChild(item);
  });
}

document.querySelectorAll(".filter").forEach(button => {
  button.addEventListener("click", () => {
    currentFilter = button.dataset.filter;

    document.querySelectorAll(".filter").forEach(item => {
      item.classList.toggle("active", item === button);
    });

    renderTasks();
  });
});

document.getElementById("prevMonth").addEventListener("click", () => {
  calendarDate.setMonth(calendarDate.getMonth() - 1);
  renderCalendar();
});

document.getElementById("nextMonth").addEventListener("click", () => {
  calendarDate.setMonth(calendarDate.getMonth() + 1);
  renderCalendar();
});

function renderAll() {
  renderTasks();
  renderCalendar();
}

renderAll();